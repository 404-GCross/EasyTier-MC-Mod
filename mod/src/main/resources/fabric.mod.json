{
  "schemaVersion": 1,
  "id": "easytier-mcmod",
  "version": "1.0.0",
  "name": "EasyTier Mod",
  "description": "P2P VPN integration for Minecraft - manage EasyTier directly in-game",
  "authors": ["EasyTier Community"],
  "contact": {
    "homepage": "https://easytier.cn",
    "sources": "https://github.com/EasyTier/EasyTier"
  },
  "license": "MIT",
  "icon": "assets/easytier-mcmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.easytier.mcmod.EasyTierMod"
    ],
    "client": [
      "com.easytier.mcmod.EasyTierModClient"
    ],
    "modmenu": [
      "com.easytier.mcmod.screen.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "easytier-mcmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabric-api": ">=0.100.0",
    "minecraft": ">=1.21.4"
  },
  "recommends": {
    "modmenu": ">=11.0.0"
  }
}
